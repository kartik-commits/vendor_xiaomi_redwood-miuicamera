 AndroidManifest.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 846f921da..8900611c4 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -234,7 +234,7 @@
                 <action android:name="com.miui.bugreport.intent.ACTION_DUMP_CACHED_LOG"/>
             </intent-filter>
         </provider>
-        <service android:enabled="true" android:exported="true" android:icon="@drawable/ic_remote_camera_control" android:label="@string/video_cast_service_name" android:name="com.xiaomi.camera.videocast.VideoCastTileService" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
+        <service android:enabled="false" android:exported="false" android:icon="@drawable/ic_remote_camera_control" android:label="@string/video_cast_service_name" android:name="com.xiaomi.camera.videocast.VideoCastTileService" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
             <intent-filter>
                 <action android:name="android.service.quicksettings.action.QS_TILE"/>
             </intent-filter>
